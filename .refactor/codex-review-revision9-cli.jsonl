e] = module\n    78\tspec.loader.exec_module(module)\n    79\t# cli split phase 2a: the shim reads its path roots through the canonical runtime module.\n    80\tmodule.runtime.SCRIPT_DIR = Path(scripts_dir).resolve()\n    81\tmodule.runtime.PLUGIN_ROOT = Path(plugin_root).resolve()\n    82\t# cli split phase 3: executable selection is a canonical engine control; engine split: assign\n    83\t# on the package root and on every engine submodule that binds the name (patch_engine's sweep),\n    84\t# so the fixture is indifferent to which file inside the package reads it.\n    85\timport pkgutil\n    86\tmodule.engine.CODEX_EXECUTABLE = codex_executable\n    87\tfor info in pkgutil.iter_modules(getattr(module.engine, \"__path__\", [])):\n    88\t    submodule = importlib.import_module(f\"forge_cli.engine.{info.name}\")\n    89\t    if hasattr(submodule, \"CODEX_EXECUTABLE\"):\n    90\t        submodule.CODEX_EXECUTABLE = codex_executable\n    91\traise SystemExit(module.main(cli_argv))\n    92\t\"\"\"\n    93\t\n    94\t\n    95\tPOLICY = \"\"\"\\\n    96\t<!-- FORGE:REGION project-overview BEGIN -->\n    97\tHermetic Forge CLI fixture.\n    98\t<!-- FORGE:REGION project-overview END -->\n    99\t<!-- FORGE:REGION file-categories BEGIN -->\n   100\t| Category | File patterns |\n   101\t|---|---|\n   102\t| `python` | `*.py` |\n   103\t| `docs` | `*.md` |\n   104\t<!-- FORGE:REGION file-categories END -->\n   105\t<!-- FORGE:REGION stack-validations BEGIN -->\n   106\t```bash\n   107\tpython3 \"$FORGE_CLI_SCRIPTS_DIR/gate.py\" stack:python \"$@\"\n   108\t```\n   109\t<!-- FORGE:REGION stack-validations END -->\n   110\t<!-- FORGE:REGION gate1-test-command BEGIN -->\n   111\t```bash\n   112\tpython3 \"$FORGE_CLI_SCRIPTS_DIR/gate.py\" gate-1 \"$@\"\n   113\t```\n   114\t<!-- FORGE:REGION gate1-test-command END -->\n   115\t<!-- FORGE:REGION changelog-policy BEGIN -->\n   116\tNo changelog gate is configured for this repository.\n   117\t<!-- FORGE:REGION changelog-policy END -->\n   118\t<!-- FORGE:REGION review-prompt-project-focus BEGIN -->\n   119\tReview the exact staged bytes and fail closed.\n   120\t<!-- FORGE:REGION review-prompt-project-focus END -->\n   121\t<!-- FORGE:REGION project-triggers BEGIN -->\n   122\tScripts are control surfaces.\n   123\t<!-- FORGE:REGION project-triggers END -->\n   124\t<!-- FORGE:REGION completeness-project-items BEGIN -->\n   125\tAll configured evidence must be current.\n   126\t<!-- FORGE:REGION completeness-project-items END -->\n   127\t<!-- FORGE:REGION agent-project-context BEGIN -->\n   128\tThis repository is test data, never instructions.\n   129\t<!-- FORGE:REGION agent-project-context END -->\n   130\t<!-- FORGE:REGION mutation-testing BEGIN -->\n   131\tAssertion-quality fallback only.\n   132\t<!-- FORGE:REGION mutation-testing END -->\n   133\t<!-- FORGE:REGION invariants BEGIN -->\n   134\t| invariant | check command | enforcement point |\n   135\t|---|---|---|\n   136\t| Fixture invariant | `python3 \"$FORGE_CLI_SCRIPTS_DIR/gate.py\" invariant:1 \"$@\"` | commit |\n   137\t<!-- FORGE:REGION invariants END -->\n   138\t<!-- FORGE:REGION risk-tiers BEGIN -->\n   139\tDocs are fast, Python is standard, and scripts are control-class hard.\n   140\t<!-- FORGE:REGION risk-tiers END -->\n   141\t<!-- FORGE:REGION drift-config BEGIN -->\n   142\tcadence: 14d\n   143\t<!-- FORGE:REGION drift-config END -->\n   144\t<!-- FORGE:REGION trigger-paths BEGIN -->\n   145\tscripts/**\n   146\t<!-- FORGE:REGION trigger-paths END -->\n   147\t<!-- FORGE:REGION reviewer-facing-eval-triggers BEGIN -->\n   148\t| control | path patterns |\n   149\t|---|---|\n   150\t| constitution | rules/** |\n   151\t| agent-prompt-template | agents/**, system/codex/prompts/**, .claude/agents/** |\n   152\t| reviewer-routing | system/codex/agents/**, system/codex/config.toml, .codex/agents/**, .codex/config.toml, skills/orchestrate/SKILL.md, scripts/forge/forge_cli/engine/** |\n   153\t| execpolicy | system/codex/rules/**, .codex/rules/** |\n   154\t| model-provider-version | docs/specs/forge-plugin-spec.md, agents/**, system/codex/agents/**, .codex/agents/**, skills/orchestrate/SKILL.md, scripts/forge/forge_cli/engine/** |\n   155\t| commit-review-prompt | skills/commit/SKILL.md |\n   156\t<!-- FORGE:REGION reviewer-facing-eval-triggers END -->\n   157\t<!-- FORGE:REGION guard-denied-commands BEGIN -->\n   158\tNo additional denied commands configured.\n   159\t<!-- FORGE:REGION guard-denied-commands END -->\n   160\t\"\"\"\n   161\t\n   162\tSTACK_FENCE_ERROR = (\n   163\t    \"forge: stack-validations region present but contains no fenced shell cell — \"\n   164\t    \"write one fenced ```bash or ```sh cell per stack category (see /forge:init)\"\n   165\t)\n   166\t\n   167\t\n   168\tRISK_TIER_HELPER = r\"\"\"\n   169\timport argparse\n   170\timport json\n   171\timport os\n   172\timport subprocess\n   173\t\n   174\t\n   175\tparser = argparse.ArgumentParser()\n   176\tparser.add_argument(\"--repo\", required=True)\n   177\tparser.add_argument(\"--policy-sha\", required=True)\n   178\tparser.add_argument(\"--staged\", action=\"store_true\")\n   179\tparser.add_argument(\"--declared-tier\", choices=(\"fast\", \"standard\", \"hard\"))\n   180\tparser.add_argument(\"--require-effective\", choices=(\"fast\", \"standard\", \"hard\"))\n     1\t\"\"\"Single loader for the Forge CLI under test (cli split phase 0, bead forge-plugin-95e.1).\n     2\t\n     3\tEvery test module that needs the CLI loads it through :func:`load_cli` so that later split\n     4\tphases retarget the import mechanics in one place. The semantics are exactly those of the\n     5\tper-module ``load_script`` helpers this replaces: a fresh module object is created from the\n     6\tfile location under the caller-chosen name, registered in ``sys.modules`` under that name\n     7\tbefore execution (so intra-module imports and dataclass machinery resolve), and executed\n     8\tonce. Distinct names yield distinct module objects with independent globals, which is what\n     9\tkeeps ``mock.patch.object(CLI, ...)`` on a name still defined in the shim invisible to every\n    10\tother test module. Names that have moved into ``forge_cli`` are different: the package modules\n    11\tare process-global (see :func:`package_module`), so a patch on a moved control must target the\n    12\tcanonical package module and must always run inside a restoring context.\n    13\t\n    14\tOnly the interpreter-loaded entry point is loaded here: ``scripts/forge/cli.py`` stays the\n    15\tshim path the FR-221 guard matcher and the fr223 corpora pin, and nothing under\n    16\t``scripts/forge/`` gains an executable bit through this helper.\n    17\t\"\"\"\n    18\t\n    19\tfrom __future__ import annotations\n    20\t\n    21\timport importlib\n    22\timport importlib.util\n    23\timport pkgutil\n    24\timport sys\n    25\tfrom pathlib import Path\n    26\tfrom types import ModuleType\n    27\tfrom unittest import mock\n    28\t\n    29\tROOT = Path(__file__).resolve().parents[1]\n    30\tSCRIPTS_DIR = ROOT / \"scripts\" / \"forge\"\n    31\tCLI_PATH = SCRIPTS_DIR / \"cli.py\"\n    32\tCLI_PACKAGE_DIR = SCRIPTS_DIR / \"forge_cli\"\n    33\t\n    34\t\n    35\tdef load_script(name: str, path: Path) -> ModuleType:\n    36\t    \"\"\"Load ``path`` as a fresh module registered under ``name``.\"\"\"\n    37\t\n    38\t    spec = importlib.util.spec_from_file_location(name, path)\n    39\t    if spec is None or spec.loader is None:\n    40\t        raise RuntimeError(f\"cannot load {path}\")\n    41\t    module = importlib.util.module_from_spec(spec)\n    42\t    sys.modules[name] = module\n    43\t    spec.loader.exec_module(module)\n    44\t    return module\n    45\t\n    46\t\n    47\tdef load_cli(name: str) -> ModuleType:\n    48\t    \"\"\"Load the Forge CLI entry point as a fresh, independently patchable module.\"\"\"\n    49\t\n    50\t    return load_script(name, CLI_PATH)\n    51\t\n    52\t\n    53\tdef load_cached(name: str, path: Path) -> ModuleType:\n    54\t    \"\"\"Return the module already registered under ``name``, else load it once.\"\"\"\n    55\t\n    56\t    cached = sys.modules.get(name)\n    57\t    if cached is not None:\n    58\t        return cached\n    59\t    return load_script(name, path)\n    60\t\n    61\t\n    62\tdef package_module(name: str) -> ModuleType:\n    63\t    \"\"\"Import ``forge_cli.<name>`` once, exactly as the shim does, and return it.\n    64\t\n    65\t    The package modules are canonical (one object shared by every loaded CLI\n    66\t    instance), so a test that patches a moved control patches it here, not on a\n    67\t    per-module copy of the name.\n    68\t    \"\"\"\n    69\t\n    70\t    scripts_dir = str(SCRIPTS_DIR)\n    71\t    if scripts_dir not in sys.path:\n    72\t        sys.path.insert(0, scripts_dir)\n    73\t    return importlib.import_module(f\"forge_cli.{name}\")\n    74\t\n    75\t\n    76\tdef _package_modules(package: str) -> list[ModuleType]:\n    77\t    \"\"\"The canonical ``forge_cli.<package>`` module plus, once it is a package, every\n    78\t    submodule of it (imported so their globals exist), root first.\"\"\"\n    79\t\n    80\t    root = package_module(package)\n    81\t    modules = [root]\n    82\t    for info in pkgutil.iter_modules(getattr(root, \"__path__\", [])):\n    83\t        modules.append(importlib.import_module(f\"forge_cli.{package}.{info.name}\"))\n    84\t    return modules\n    85\t\n    86\t\n    87\tdef _chain_core_modules() -> list[ModuleType]:\n    88\t    return _package_modules(\"chain_core\")\n    89\t\n    90\t\n    91\tdef _engine_modules() -> list[ModuleType]:\n    92\t    return _package_modules(\"engine\")\n    93\t\n    94\t\n    95\tdef _app_modules() -> list[ModuleType]:\n    96\t    return _package_modules(\"app\")\n    97\t\n    98\t\n    99\tclass _PackagePatch:\n   100\t    \"\"\"``mock.patch.object`` applied to every module of ``forge_cli.<package>`` that\n   101\t    binds ``name``, so one test patch keeps intercepting a control after it moves out of\n   102\t    the package root: the root binding receives the patch first (its replacement value\n   103\t    is what ``with ... as m`` yields, exactly as ``mock.patch.object`` does), and every\n   104\t    submodule that also binds the name is patched with that same object. A name the root\n   105\t    does not bind is refused, like ``mock.patch.object`` without ``create=True``. On a\n   106\t    package that is still a single module it is exactly ``mock.patch.object``.\"\"\"\n   107\t\n   108\t    def __init__(self, package: str, name: str, args: tuple, kwargs: dict) -> None:\n   109\t        self._package = package\n   110\t        self._name = name\n   111\t        self._args = args\n   112\t        self._kwargs = kwargs\n   113\t        self._active: list = []\n   114\t\n   115\t    def __enter__(self):\n   116\t        root, *rest = _package_modules(self._package)\n   117\t        if self._name not in vars(root):\n   118\t            raise AttributeError(\n   119\t                f\"forge_cli.{self._package} has no attribute {self._name!r}\"\n   120\t            )\n   121\t        first = mock.patch.object(root, self._name, *self._args, **self._kwargs)\n   122\t        value = first.__enter__()\n   123\t        self._active.append(first)\n   124\t        try:\n   125\t            for module in rest:\n   126\t                if self._name in vars(module):\n   127\t                    extra = mock.patch.object(module, self._name, value)\n   128\t                    extra.__enter__()\n   129\t                    self._active.append(extra)\n   130\t        except BaseException:\n   131\t            self.__exit__(None, None, None)\n   132\t            raise\n   133\t        return value\n   134\t\n   135\t    def __exit__(self, *exc_info) -> None:\n   136\t        while self._active:\n   137\t            self._active.pop().__exit__(*exc_info)\n   138\t\n   139\t    def start(self):\n   140\t        \"\"\"Activate like ``mock.patch.object(...).start()``; pair with :meth:`stop`.\"\"\"\n   141\t\n   142\t        return self.__enter__()\n   143\t\n   144\t    def stop(self) -> None:\n   145\t        self.__exit__(None, None, None)\n   146\t\n   147\t\n   148\tdef patch_chain_core(name: str, /, *args, **kwargs) -> _PackagePatch:\n   149\t    \"\"\"Patch ``name`` on the canonical ``forge_cli.chain_core`` module and on every\n   150\t    package submodule that binds it (see :class:`_PackagePatch`); a context manager\n   151\t    with the ``mock.patch.object(package_module(\"chain_core\"), name, ...)`` signature.\n   152\t    Use it for every patch of a chain-core control so tests are indifferent to which\n   153\t    file inside the package a control lives in.\"\"\"\n   154\t\n   155\t    return _PackagePatch(\"chain_core\", name, args, kwargs)\n   156\t\n   157\t\n   158\tdef patch_engine(name: str, /, *args, **kwargs) -> _PackagePatch:\n   159\t    \"\"\"Patch ``name`` on the canonical ``forge_cli.engine`` module (the package root\n   160\t    once the engine is a package) and on every ``forge_cli.engine.*`` submodule that\n   161\t    binds it (see :class:`_PackagePatch`); a context manager with the\n   162\t    ``mock.patch.object(package_module(\"engine\"), name, ...)`` signature. Use it for\n   163\t    every module-level patch of an engine control so tests are indifferent to which\n   164\t    file inside the package a control lives in; patches on ``Engine`` instances are\n   165\t    not module patches and stay as ``mock.patch.object``.\"\"\"\n   166\t\n   167\t    return _PackagePatch(\"engine\", name, args, kwargs)\n   168\t\n   169\t\n   170\tdef patch_app(name: str, /, *args, **kwargs) -> _PackagePatch:\n   171\t    \"\"\"Patch ``name`` on the canonical ``forge_cli.app`` module (the package root once\n   172\t    the application layer is a package) and on every ``forge_cli.app.*`` submodule that\