ncode\") != 0\n        or type(payload.get(\"tests_run\")) is not int\n        or payload.get(\"tests_run\") != 1\n        or payload.get(\"suite_tail\") != \"OK\"\n        or raw != result_evidence(slot, result_id, command[3], candidate)\n","exit_code":0,"status":"completed"}}
