in depth and prepends\n   255\t    its exact `## Historical Routing Findings` section to the audit output. Its stdout is the sole\n   256\t    source for the archive's routing findings, residual-risk, and follow-up sections; a nonzero exit\n   257\t    is fail closed, so do not create an archive and therefore do not write a report:\n   258\t\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport argparse\n     4\timport io\n     5\timport json\n     6\timport os\n     7\timport re\n     8\timport stat\n     9\timport subprocess\n    10\timport sys\n    11\timport types\n    12\timport unittest\n    13\tfrom contextlib import redirect_stderr, redirect_stdout\n    14\tfrom pathlib import Path\n    15\tfrom unittest import mock\n    16\t\n    17\timport tomllib\n    18\t\n    19\tROOT = Path(__file__).resolve().parents[1]\n    20\tPOLICY_PATH = Path(\"forge-project.md\")\n    21\tSPEC_PATH = Path(\"docs/specs/forge-plugin-spec.md\")\n    22\tIMPLEMENTER_PATH = Path(\"system/codex/agents/implementer.toml\")\n    23\tREVIEWER_PATH = Path(\"system/codex/agents/review-cheap.toml\")\n    24\tFINAL_REVIEWER_PATH = Path(\"agents/review-final.md\")\n    25\tROLE_PATHS = {\n    26\t    \"implementation\": IMPLEMENTER_PATH,\n    27\t    \"review\": REVIEWER_PATH,\n    28\t}\n    29\t\n    30\t\n    31\tclass ConformanceError(RuntimeError):\n    32\t    pass\n    33\t\n    34\t\n    35\tdef git(repo: Path, *arguments: str) -> subprocess.CompletedProcess[bytes]:\n    36\t    return subprocess.run(\n    37\t        [\"git\", *arguments], cwd=repo, check=False, capture_output=True\n    38\t    )\n    39\t\n    40\t\n    41\tdef committed_text(repo: Path, revision: str, path: Path) -> str:\n    42\t    result = git(repo, \"show\", f\"{revision}:{path.as_posix()}\")\n    43\t    if result.returncode != 0:\n    44\t        raise ConformanceError(\n    45\t            f\"{revision}:{path.as_posix()} is unavailable\"\n   960\t            [\"git\", \"rev-parse\", \"HEAD\"], cwd=repo, check=True, text=True, capture_output=True\n   961\t        ).stdout.strip()\n   962\t        run_dir = repo / \"run\"\n   963\t        run_dir.mkdir()\n   964\t        (run_dir / \"journal.jsonl\").write_text(\n   965\t            json.dumps(\n   966\t                {\n   967\t                    \"type\": \"execution\",\n   968\t                    \"agent\": \"codex-review-01\",\n   969\t                    \"provider\": \"codex\",\n   970\t                    \"event_source\": \"exec\",\n   971\t                    \"role\": \"review\",\n   972\t                    \"head\": head,\n   973\t                    \"model\": \"gpt-5.6-sol\",\n   974\t                    \"effort\": \"high\",\n   975\t                }\n   976\t            )\n   977\t            + \"\\n\",\n   978\t            encoding=\"utf-8\",\n   979\t        )\n   980\t\n   981\t        errors, findings = check_run(repo, run_dir)\n   982\t\n   983\t        self.assertEqual(findings, [])\n   984\t        self.assertEqual(len(errors), 1)\n   985\t        self.assertIn(\"is unavailable\", errors[0])\n   986\t\n   987\t    def test_historical_audit_ignores_later_authority_changes(self) -> None:\n   988\t        repo = self.fixture_repo()\n   989\t        old_head = subprocess.run(\n   990\t            [\"git\", \"rev-parse\", \"HEAD\"], cwd=repo, check=True, text=True, capture_output=True\n   991\t        ).stdout.strip()\n   992\t        route = repo / REVIEWER_PATH\n   993\t        route.write_text(\n   994\t            route.read_text(encoding=\"utf-8\").replace(\n   995\t                'model_reasoning_effort = \"high\"',\n   996\t                'model_reasoning_effort = \"medium\"',\n   997\t            ),\n   998\t            encoding=\"utf-8\",\n   999\t        )\n  1000\t        subprocess.run([\"git\", \"add\", str(REVIEWER_PATH)], cwd=repo, check=True)\n  1001\t        subprocess.run([\"git\", \"commit\", \"-q\", \"-m\", \"new routing\"], cwd=repo, check=True)\n  1002\t        run_dir = repo / \"run\"\n  1003\t        run_dir.mkdir()\n  1004\t        (run_dir / \"journal.jsonl\").write_text(\n  1005\t            json.dumps(\n  1006\t                {\n  1007\t                    \"type\": \"execution\",\n  1008\t                    \"agent\": \"codex-review-01\",\n  1009\t                    \"provider\": \"codex\",\n  1010\t                    \"event_source\": \"exec\",\n  1011\t                    \"role\": \"review\",\n  1012\t                    \"head\": old_head,\n  1013\t                    \"model\": \"gpt-5.6-sol\",\n  1014\t                    \"effort\": \"high\",\n  1015\t                }\n  1016\t            )\n  1017\t            + \"\\n\",\n  1018\t            encoding=\"utf-8\",\n  1019\t        )\n  1020\t\n  1021\t        self.assertEqual(check_run(repo, run_dir), ([], []))\n  1022\t\n  1023\t    def test_historical_audit_uses_final_agent_at_claude_execution_head(\n  1024\t        self,\n  1025\t    ) -> None:\n  1026\t        repo = self.fixture_repo()\n  1027\t        head = subprocess.run(\n  1028\t            [\"git\", \"rev-parse\", \"HEAD\"], cwd=repo, check=True, text=True, capture_output=True\n  1029\t        ).stdout.strip()\n  1030\t        run_dir = repo / \"run\"\n   255\tRuns are admitted by declared file scope rather than refused outright, and\n   256\toverlapping scopes are named on refusal. Reintegrations serialize through one\n   257\tarbiter in the Git common directory, so worktrees using that common directory\n   258\tcontend on the same lock.\n   259\t\n   260\tDecision-event emission is designed for lossless concurrent appends on local POSIX\n   261\tfilesystems. Current CI evidence covers Ubuntu; macOS is an intended but unproven\n   262\ttarget. NFS and SMB are unsupported, and Windows is out of scope.\n   263\t\n   264\t## Development\n   265\t\n   266\t```sh\n   267\tpython3 -m unittest discover -s tests\n   268\t```\n   269\t\n   270\tThe plain command above is the sequential developer form. The committed gate-1\n   271\tcell in `forge-project.md` discovers the same modules and partitions them round-robin\n   272\tacross `max(1, min(4, os.cpu_count() or 1))` shards inside one cell. The previously\n   273\tobserved roughly-one-third sequential wall time was measured on an eight-core host\n   274\twhile the cell used four shards; it is not a four-core benchmark or a promised\n   275\tspeedup.\n   735\tRevision-13 citation-root amendment to **FR-011** (bead forge-plugin-7t0): the file-existence checks that `validate` and the run-close validation apply to `execution.prompt`, `execution.events`, `execution.handoff`, `execution_result.handoff`, and `verification.evidence[<n>]` MUST resolve a relative citation against the run directory first (the upstream resolve-then-exist reading, unchanged) and, only when it is absent there, against the run's repository root through the same ordered resolve-then-contain predicate FR-017 applies at append time, so a gate verification drained by a run-bound chain that cites repository-relative `.forge/chains/<chain-id>/evidence/…` validates without a hand-made mirror under the run directory. The repository root is derived only from the fixed run layout `<repository>/.codex-orchestrator/runs/<run-id>` after resolving the run directory physically (a symlinked run directory therefore derives the repository that physically contains it); journal data never widens it, a citation whose resolved path escapes the repository root (symlink or `..`) never satisfies the repository leg, an absolute citation keeps its upstream run-only reading, and a citation absent from both roots reports the unchanged upstream diagnostic. The FR-016 missing-file legacy legs consult both roots before tolerating. A consumer that validates a mirrored journal outside the fixed layout MUST pass the real run's layout-derived repository root explicitly (`validate_run(…, repository=…)`); the archive's FR-024 pre-close recompute does, so a run that closes `passed` in layout re-validates identically in the archive's mirror. The repository leg is a named control (`VALIDATION_REPOSITORY_LEG`) with a disable-in-memory proof that restores run-relative-only resolution for both the layout root and the explicit override.\n   736\t\n   737\tRevision-9 amendment to **FR-011**: every journal reader takes the stable per-run batch sidecar lock in shared mode before inspecting the intent, opens `journal.jsonl` no-follow, records its device, inode, and size, reads and `fstat`s the same descriptor, and rechecks the intent plus identity and size before using the bytes. A pending intent, inode replacement, or size change discards the read and refuses exactly `forge: journal read refused — pending or changed batch transaction`; it never returns a partial snapshot. Readers MUST NOT append, repair, unlink, write a receipt, or perform recovery. This locked refusal is the only Revision-9 change to reading; the four-key plain payload and all historical semantics above remain unchanged when no transaction is pending.\n   738\t\n   739\tRevision-14 activation amendment to **FR-011**: within that stable locked snapshot, every reader recognizes activation either from the opening `run_started.writer_contract` or from exactly one DM-001 activation decision. Opening activation requires an authenticated receipt chain whose selected origin is byte zero; decision activation requires the marker's exact reserved grammar, matching run identity, authenticated legacy-prefix digest, one ordinary receipt covering the marker, and contiguous ledger coverage from its declared `receipt_origin_size` through the snapshot's journal EOF. A partial, duplicate, malformed, unreceipted, or prefix-mismatched activation candidate fails closed and is never read as unactivated legacy. Readers inspect the complete journal and receipt ledger to classify this state but remain read-only: they never inject a marker, repair coverage, replay a batch, write a receipt, or unlink an intent.\n   740\t- **FR-012** (MUST): The `state` and `monitor` subcommands MUST preserve upstream behavior: state statuses `idle|starting|active|complete|failed|unknown`, exit 2 on low parse confidence with the incompatibility message on stderr; monitor payload types `codex_agent_complete|codex_agent_failed|codex_agent_unknown|codex_agent_stale|monitor_error`, mtime-based staleness (default 600 s), selector exclusivity, and exit-code rules.\n   741\t- **FR-013** (MUST): The vendored unittest suite MUST pass via `python3 -m unittest discover -s tests` from the plugin root. Doc-contract assertions MUST be migrated, not deleted: each of the 24 upstream assertions is either retained (engine prose unchanged), updated to the merged skill/doc text, or removed with a line in `UPSTREAM` naming the assertion and why.\n   742\t- **FR-014** (MUST): Before opening a run, the workflow skill MUST declare its nonempty intended repository file scope and use DM-011's locked two-phase reconciliation to compare it atomically with every open run and every derived scope-reserving retired leaf. An ordinary run is admitted only when its scope is disjoint from all such reservations. Each open-run overlap retains exactly `forge: new run refused — scope overlap between <new-run-id> and open run <open-run-id>`; each retired-leaf overlap refuses exactly `forge: new run refused — scope overlap between <new-run-id> and scope-reserving retired run <retired-run-id>`. All conflict lines form one list sorted bytewise by the named conflicting run ID. A user-designated successor MAY reuse scope only when its named immediate predecessor is the scope-reserving retired leaf whose reservation is atomically transferred: otherwise it MUST refuse exactly `forge: successor run refused — predecessor <predecessor-id> is not a scope-reserving retired run`, and a proposed successor scope that does not overlap that predecessor MUST refuse exactly `forge: successor run refused — scope of <new-run-id> does not overlap scope-reserving retired run <predecessor-id>`. A valid successor and its later readmissions are exempt from every retired ancestor in their own transitive lineage, but not from unrelated open or retired-leaf reservations; the immediate predecessor's existing foreign-live-owner refusal remains byte-identical. Historical forks, second-child refusal, passed/blocked release, rollback preservation, and dangling/cyclic fail-closed behavior are as derived by DM-011 and FR-192. Except for DM-011's one silent empty-placeholder class and its named nonempty-orphan refusal, missing, malformed, ambiguous, or inconsistent persisted lifecycle, identity, scope, journal, or registry state MUST fail closed with `forge: new run refused — run registry unavailable`. Every `task.files` entry MUST be contained by the admitted scope; widening requires fresh admission under the same lock before any append or mutation.\n   743\t- **FR-015** (MUST): Run initialization MUST keep the upstream local-exclude protocol: append `/.codex-orchestrator/` to `git rev-parse --git-path info/exclude`, verify with `git check-ignore`, and never edit tracked `.gitignore` for the run root.\n   744\t- **FR-016** (MUST): Legacy journal compatibility posture. A journal opts pre-existing records into dialect tolerance only through a `decision` entry whose `id` is exactly `journal-dialect-compat` and whose `resolution` is exactly `legacy-dialect-compat: <justification>` with a nonempty single-line justification (CR/LF forbidden). Tolerance applies solely to records on physical lines before the first such declaration; every record at or after it, including `run_closed`, validates fully strict, and a journal without a declaration validates byte-identically to FR-011/FR-020. Exactly ten diagnostics may be reclassified from issues to line-numbered warnings, each emitted per application plus one activation warning — except leg (7), which emits exactly one consolidated warning per tolerated duplicate ID naming every occurrence line: (1) `observation` entry types; (2) `verification` results of `pass`, or an absent `result` with `status: pass`, normalized to `passed` — a present-but-malformed `result` is never rescued; (3) nonempty string `evidence` normalized to a singleton list before the existence check; (4) `execution_result` statuses mapped exactly `handoff-ready`→`complete`, `pass`→`complete`, `block`→`blocked`; (5) execution/result task mismatches only when both records precede the declaration and both task IDs name known tasks, the execution's task being authoritative; (6) referenced prompt/events paths that do not exist (including the historical `(inline)` sentinel) — wrong types and existing non-file paths stay hard; (7) duplicate `verification` IDs only when every occurrence precedes the declaration; (8) executions with no terminal `execution_result`; (9) empty-string `events` references; (10) failed gate verifications lacking a later identical-criterion passing recheck. Leg (8) also governs FR-021's unterminated-mutation gate veto: a pre-declaration mutating execution with no terminal result does not veto gate verifications, a pre-declaration terminal result still anchors gate ordering (gates recorded before it stay vetoed), and a post-declaration unterminated mutating execution vetoes every gate. Nothing else is tolerated: JSON decodability, run lifecycle placement, `judgment` values, citation-correction grammar and targets, duplicate `decision` IDs (including a second declaration), task terminality, and every unlisted diagnostic stay hard for all records. Raw records remain authoritative for lifecycle and citation checks; validator-assigned line numbers are never taken from journal content; `non_passing_verifications` reporting is unchanged by tolerance. Each tolerance leg MUST be independently disableable in code with a focused test that fails when it is disabled, and extending the tolerated set is a control-class change requiring binding review and explicit operator approval. For a journal that is already closed — where no declaration is appendable — FR-018's operator-directed flag is the sole out-of-band keying for this posture.\n   745\t- **FR-017** (MUST): Append-time citation-root enforcement. `run-open`, `journal-append`, and `run-close` MUST validate every path-like citation in the proposed record before writing anything: `execution.prompt`, `execution.events`, `execution.handoff`, `execution_result.handoff`, each `verification.evidence[]` entry, each path-like `decision.basis[]` entry, and each path token of `verification.observation` — the complete set of citation surfaces the commitment audit later checks; append-time coverage and audit-time coverage MUST remain exactly coextensive, and extending one without the other is a defect. Path-likeness MUST be decided by the same committed tokenizer the commitment audit uses (`scripts/forge/commitment_paths.py`, with its per-surface contexts) — one predicate, both enforcement points, never a second implementation — and the containment decision MUST be the audit's own predicate applied identically at both points: an absolute citation is refused outright (in-root content is always expressible relatively), and a relative citation is resolved with symlinks followed (resolve-then-contain) against the run directory first and the repository root second. A violating record MUST refuse with exactly `forge: journal append refused — record cites path outside run or repository: <field>: <path>`, where `<field>` is `execution.prompt`, `execution.events`, `execution.handoff`, `execution_result.handoff`, `verification.evidence[<n>]`, `decision.basis[<n>]`, or `verification.observation token <token>`, and write nothing, so the author corrects the citation at the only moment it is still correctable. Non-path basis and observation content (record IDs, prose) is untouched; the journal schema and upstream reader behavior remain unchanged under FR-010/FR-011. The enforcement MUST be independently disableable in code with a focused test that fails when it is disabled in memory.\n   746\t- **FR-018** (MUST): Operator-directed closed-run dispensation. A closed journal cannot carry a new declaration or citation-correction (`run_closed` is final), so the only sanctioned relaxations for closed, otherwise-unarchivable runs are explicit operator-directed flags with always-visible output. (a) `validate --gates --closed-legacy-compat \"<justification>\"` — nonempty single-line justification, CR/LF forbidden, mirroring FR-016's grammar — MUST treat the closed journal as pre-declaration under FR-016's posture with the virtual declaration point immediately before `run_closed`: the identical ten legs with identical semantics for every earlier record, one activation warning naming the operator-supplied justification, and `run_closed` itself always fully strict, preserving FR-016's guarantee that no keying — in-journal or flag — can relax it. The flag MUST refuse on a journal without `run_closed` with exactly `forge: closed-legacy-compat refused — journal has no run_closed entry` (for open runs the in-journal declaration remains the only path), and without the flag validation MUST remain byte-identical to FR-011/FR-016. (b) The commitment audit and the archive renderer MUST accept repeatable `--dispense-citation` targets in exactly two forms mirroring FR-191's correction grammar — `<decision-id> basis[<n>]` and `<verification-id> observation: <token>` — plus one required `--dispense-reason \"<text>\"` whose grammar is identical to (a)'s justification: nonempty, single line, CR/LF forbidden. Target parsing is exact-match on those two shapes; a target whose record ID is ambiguous (duplicate IDs in the journal) MUST be refused as ambiguous rather than resolved by position. Exactly the named missing citations degrade from the fail(5) refusal to a `## Dispensed Citations` section listing each citation, its unresolved path, and the reason; every non-dispensed missing citation of either kind still fails(5); a dispensation naming a citation that resolves, a malformed target, or a target the journal does not contain MUST fail with a diagnostic rather than being ignored; the archive MUST render the section and record the exact dispensation flags under provenance, and FR-171's required-contents inventory includes that section and provenance record whenever dispensation was used. (c) Authority: both flag surfaces are operator-reserved — a skill MAY pass them only on explicit operator direction naming the run, that direction is recorded in the rendered archive, and use without direction is a control failure, not a convenience. (d) Every dispensation leg MUST be independently disableable in code with a focused test that fails when it is disabled in memory, and no-flag parity MUST be pinned by test. (e) This mechanism exists only for closed journals; it never weakens open-run validation, the FR-017 source control, or any non-citation audit refusal.\n  3146\t- Revision-9 smoke: activated `run-open` → run/task-bound commit and merge events → receipted typed journal records → explicit task finish → journal-only `validate --gates` → bounded exact chain-evidence archive → rerender-equality archive-only commit → report, with one injected outbox crash recovered before the next transition and upstream seven-type/plain-validation parity retained.\n  3147\t- Revision-9 legacy smoke: the committed 109-record GH#5 fixture validates under its declaration while an equivalent new append refuses; the separately closed phase-0 fixture renders only under a per-instance operator decision naming its recovered HEAD, creates only the absent archive, and leaves every prior DM-008 archive and source journal byte-identical.\n  3148\t\n  3149\t## 12. Success Criteria\n  3150\t\n  3151\t- **SC-001**: `python3 -m unittest discover -s tests` exits 0 from the plugin root on macOS and Linux with bare Python ≥ 3.10 (no packages installed).\n  3152\t- **SC-002**: `validate` without `--gates` on the extended replay journal produces a payload with exactly the four upstream keys and exit 0; with `--gates`, the same journal yields `ok: true`, `profile: \"gates\"`, exit 0.\n  3153\t- **SC-003**: The two gates-negative fixtures produce exactly the FR-021 and FR-022 issue strings respectively, with exit 1.\n  3154\t- **SC-004**: On a freshly initialized scaffold repo before region filling, `grep -rln \"forge-init:\" forge-project.md` is non-empty and the Gate 1 command exits 1; after `/forge:init` completes, the grep is empty and Gate 1 exits 0 on the clean tree.\n  3155\t- **SC-005**: When `HEAD:.forge-manifest` contains anchored `^plugin_ref: ` or a worktree manifest exists that does not parse as upstream schema, absence of `.forge/tmp/authorized/<authorization-id>` makes the guard deny `git commit` — including `git -C <path> commit` and `cd x && git commit`; a fresh exact v2 marker whose filename/ID/object-format/tree match the invoking index allows, while a legacy marker never does, an upstream-only manifest remains halt-only, and staged deletion of a committed plugin manifest stays armed. With `AGENT_HALT` present it denies both `git commit` and `git push` in any repo.\n","exit_code":0,"status":"completed"}}
