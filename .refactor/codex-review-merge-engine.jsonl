  if condition == \"push-outcome-unknown\"\n    15\t            else V2ReasonCode.NON_FAST_FORWARD\n    16\t            if condition == \"non-fast-forward\"\n    17\t            else None\n    18\t        )\n    19\t        if reason is not None:\n    20\t            raise chain_core._merge_refusal(\n    21\t                reason,\n    22\t                f\"forge: merge recover observed {condition}\",\n    23\t                remediation=f\"forge merge recover --chain-id {current['chain_id']}\",\n    24\t                chain=current,\n    25\t            )\n    26\t    next_steps = {\n    27\t        \"pushed\": f\"forge merge cleanup --chain-id {current['chain_id']}\",\n    28\t        \"pushing\": f\"forge merge recover --chain-id {current['chain_id']}\",\n    29\t        \"reviewing\": f\"forge review request --chain-id {current['chain_id']}\",\n    30\t        \"authorized\": f\"forge merge finalize --chain-id {current['chain_id']}\",\n    31\t        \"revising\": f\"forge merge refresh --chain-id {current['chain_id']}\",\n    32\t        \"rebase_conflict\": (\n    33\t            f\"forge merge recover --continue --paths <path>... --chain-id {current['chain_id']}\"\n    34\t        ),\n    35\t        \"closed\": \"none — merge chain closed\",\n    36\t        \"aborted\": \"none — merge chain aborted\",\n    37\t    }\n    38\t    if action == \"historical-landed-superseded\":\n    39\t        next_steps[\"aborted\"] = (\n    40\t            \"forge merge start --worktree \"\n    41\t            f\"{current['worktree']['path']}\"\n    42\t        )\n    43\t    elif action == \"inactive-not-landed\":\n    44\t        next_steps[\"pushing\"] = (\n    45\t            f\"forge merge abort --chain-id {current['chain_id']}\"\n    46\t        )\n    47\t    return next_steps\n","exit_code":0,"status":"completed"}}
