{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/usr/bin/zsh -lc \"nl -ba tests/_cli_loader.py | sed -n '1,130p' && git diff --unified=10 e4a6846..HEAD -- forge-project.md .refactor/plan-chain_core.md .refactor/plan-chain_core.json | sed -n '1,260p'\"","aggregated_output":"     1\t\"\"\"Single loader for the Forge CLI under test (cli split phase 0, bead forge-plugin-95e.1).\n     2\t\n     3\tEvery test module that needs the CLI loads it through :func:`load_cli` so that later split\n     4\tphases retarget the import mechanics in one place. The semantics are exactly those of the\n     5\tper-module ``load_script`` helpers this replaces: a fresh module object is created from the\n     6\tfile location under the caller-chosen name, registered in ``sys.modules`` under that name\n     7\tbefore execution (so intra-module imports and dataclass machinery resolve), and executed\n     8\tonce. Distinct names yield distinct module objects with independent globals, which is what\n     9\tkeeps ``mock.patch.object(CLI, ...)`` on a name still defined in the shim invisible to every\n    10\tother test module. Names that have moved into ``forge_cli`` are different: the package modules\n    11\tare process-global (see :func:`package_module`), so a patch on a moved control must target the\n    12\tcanonical package module and must always run inside a restoring context.\n    13\t\n    14\tOnly the interpreter-loaded entry point is loaded here: ``scripts/forge/cli.py`` stays the\n    15\tshim path the FR-221 guard matcher and the fr223 corpora pin, and nothing under\n    16\t``scripts/forge/`` gains an executable bit through this helper.\n    17\t\"\"\"\n    18\t\n    19\tfrom __future__ import annotations\n    20\t\n    21\timport importlib\n    22\timport importlib.util\n    23\timport pkgutil\n    24\timport sys\n    25\tfrom pathlib import Path\n    26\tfrom types import ModuleType\n    27\tfrom unittest import mock\n    28\t\n    29\tROOT = Path(__file__).resolve().parents[1]\n    30\tSCRIPTS_DIR = ROOT / \"scripts\" / \"forge\"\n    31\tCLI_PATH = SCRIPTS_DIR / \"cli.py\"\n    32\tCLI_PACKAGE_DIR = SCRIPTS_DIR / \"forge_cli\"\n    33\t\n    34\t\n    35\tdef load_script(name: str, path: Path) -> ModuleType:\n    36\t    \"\"\"Load ``path`` as a fresh module registered under ``name``.\"\"\"\n    37\t\n    38\t    spec = importlib.util.spec_from_file_location(name, path)\n    39\t    if spec is None or spec.loader is None:\n    40\t        raise RuntimeError(f\"cannot load {path}\")\n    41\t    module = importlib.util.module_from_spec(spec)\n    42\t    sys.modules[name] = module\n    43\t    spec.loader.exec_module(module)\n    44\t    return module\n    45\t\n    46\t\n    47\tdef load_cli(name: str) -> ModuleType:\n    48\t    \"\"\"Load the Forge CLI entry point as a fresh, independently patchable module.\"\"\"\n    49\t\n    50\t    return load_script(name, CLI_PATH)\n    51\t\n    52\t\n    53\tdef load_cached(name: str, path: Path) -> ModuleType:\n    54\t    \"\"\"Return the module already registered under ``name``, else load it once.\"\"\"\n    55\t\n    56\t    cached = sys.modules.get(name)\n    57\t    if cached is not None:\n    58\t        return cached\n    59\t    return load_script(name, path)\n    60\t\n    61\t\n    62\tdef package_module(name: str) -> ModuleType:\n    63\t    \"\"\"Import ``forge_cli.<name>`` once, exactly as the shim does, and return it.\n    64\t\n    65\t    The package modules are canonical (one object shared by every loaded CLI\n    66\t    instance), so a test that patches a moved control patches it here, not on a\n    67\t    per-module copy of the name.\n    68\t    \"\"\"\n    69\t\n    70\t    scripts_dir = str(SCRIPTS_DIR)\n    71\t    if scripts_dir not in sys.path:\n    72\t        sys.path.insert(0, scripts_dir)\n    73\t    return importlib.import_module(f\"forge_cli.{name}\")\n    74\t\n    75\t\n    76\tdef _chain_core_modules() -> list[ModuleType]:\n    77\t    \"\"\"The canonical ``forge_cli.chain_core`` module plus, once it is a package, every\n    78\t    submodule of it (imported so their globals exist), root first.\"\"\"\n    79\t\n    80\t    root = package_module(\"chain_core\")\n    81\t    modules = [root]\n    82\t    for info in pkgutil.iter_modules(getattr(root, \"__path__\", [])):\n    83\t        modules.append(importlib.import_module(f\"forge_cli.chain_core.{info.name}\"))\n    84\t    return modules\n    85\t\n    86\t\n    87\tclass _ChainCorePatch:\n    88\t    \"\"\"``mock.patch.object`` applied to every module of ``forge_cli.chain_core`` that\n    89\t    binds ``name``, so one test patch keeps intercepting a control after it moves out of\n    90\t    the package root: the root binding receives the patch first (its replacement value\n    91\t    is what ``with ... as m`` yields, exactly as ``mock.patch.object`` does), and every\n    92\t    submodule that also binds the name is patched with that same object. A name the root\n    93\t    does not bind is refused, like ``mock.patch.object`` without ``create=True``.\"\"\"\n    94\t\n    95\t    def __init__(self, name: str, args: tuple, kwargs: dict) -> None:\n    96\t        self._name = name\n    97\t        self._args = args\n    98\t        self._kwargs = kwargs\n    99\t        self._active: list = []\n   100\t\n   101\t    def __enter__(self):\n   102\t        root, *rest = _chain_core_modules()\n   103\t        if self._name not in vars(root):\n   104\t            raise AttributeError(f\"forge_cli.chain_core has no attribute {self._name!r}\")\n   105\t        first = mock.patch.object(root, self._name, *self._args, **self._kwargs)\n   106\t        value = first.__enter__()\n   107\t        self._active.append(first)\n   108\t        try:\n   109\t            for module in rest:\n   110\t                if self._name in vars(module):\n   111\t                    extra = mock.patch.object(module, self._name, value)\n   112\t                    extra.__enter__()\n   113\t                    self._active.append(extra)\n   114\t        except BaseException:\n   115\t            self.__exit__(None, None, None)\n   116\t            raise\n   117\t        return value\n   118\t\n   119\t    def __exit__(self, *exc_info) -> None:\n   120\t        while self._active:\n   121\t            self._active.pop().__exit__(*exc_info)\n   122\t\n   123\t    def start(self):\n   124\t        \"\"\"Activate like ``mock.patch.object(...).start()``; pair with :meth:`stop`.\"\"\"\n   125\t\n   126\t        return self.__enter__()\n   127\t\n   128\t    def stop(self) -> None:\n   129\t        self.__exit__(None, None, None)\n   130\t\ndiff --git a/.refactor/plan-chain_core.json b/.refactor/plan-chain_core.json\nindex f02c1c9..04e7b1a 100644\n--- a/.refactor/plan-chain_core.json\n+++ b/.refactor/plan-chain_core.json\n@@ -1,624 +1,630 @@\n {\n- \"planPath\": \".refactor/plan-chain_core.md\",\n- \"pkgDir\": \"scripts/forge/forge_cli\",\n- \"preWave\": {\n-  \"step\": \"git mv scripts/forge/forge_cli/chain_core.py scripts/forge/forge_cli/chain_core/__init__.py\",\n-  \"commit\": \"refactor(chain_core): convert module to package (no code moved)\"\n- },\n- \"sourceModule\": \"scripts/forge/forge_cli/chain_core/__init__.py\",\n- \"waves\": [\n-  [\n-   {\n-    \"cluster\": \"state\",\n-    \"dest\": \"scripts/forge/forge_cli/chain_core/_state.py\",\n-    \"symbols\": [\n-     \"SCHEMA\",\n-     \"KIND\",\n-     \"FRESH_REVIEWER_EVALS_GATE\",\n-     \"FRESH_REVIEWER_EVALS_REQUESTS\",\n-     \"FRESH_REVIEWER_EVALS_REQUESTED_EVENT\",\n-     \"STATES\",\n-     \"STATE_KEYS\",\n-     \"EVENT_KEYS\",\n-     \"MERGE_STATE_KEYS\",\n-     \"_MERGE_INACTIVE_ATTEMPT_OBSERVATION_SOURCES\",\n-     \"_MERGE_INACTIVE_POST_ATTEMPT_RECOVERY_SOURCES\",\n-     \"MERGE_EVENT_KEYS\",\n-     \"MERGE_EVENT_NAMES\",\n-     \"MERGE_CONSEQUENTIAL_EVENTS\",\n-     \"TIER_RANK\",\n-     \"INACTIVE_SECONDS\",\n-     \"FENCED_CHILD_ACK_TIMEOUT_SECONDS\",\n