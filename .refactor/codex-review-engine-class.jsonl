ackages = [\"forge_cli\", \"codex_orchestrator\"]\n include_external_packages = false\n # TYPE_CHECKING-guarded imports are annotations, not runtime edges (engine/_command_lock\n # and engine/_finalize name Engine that way; import-linter 2.15 takes this as a session option).\n exclude_type_checking_imports = true\n \n # forge_cli layering, top to bottom, as documented in docs/specs/forge-plugin-spec.md\n # section 5 (app -> engine -> chain_core -> fresh_evals -> leaf modules).\n [[tool.importlinter.contracts]]\n name = \"forge_cli layers\"\n type = \"layers\"\n layers = [\n     \"forge_cli.app\",\n     \"forge_cli.engine\",\n     \"forge_cli.chain_core\",\n     \"forge_cli.fresh_evals\",\n     \"forge_cli.candidate | forge_cli.runtime | forge_cli.policy | forge_cli.envelope\",\n ]\n # Pre-existing cycle (2026-09-13): runtime.py:74 lazily imports codex_orchestrator,\n # whose builders/journal lazily import forge_cli.candidate/fresh_evals/policy/\n # chain_core, which closes an indirect cycle back into the upper layers. Ignored so\n # the contract checks direct layering. TODO: remove once that seam is untangled.\n ignore_imports = [\n     \"forge_cli.runtime -> codex_orchestrator.batch\",\n     \"forge_cli.runtime -> codex_orchestrator.builders\",\n     \"forge_cli.runtime -> codex_orchestrator.journal\",\n ]\n \n # forge_cli.chain_core intra-package layering, top to bottom, in the wave order of\n # .refactor/plan-chain_core.md (wave 16 at the top, wave 0's _state at the bottom;\n # `|` marks modules of one wave that do not import each other). _fenced_process\n # imports _common_lock, so the two wave-16 modules are sequential layers. The split\n # introduced no function-local imports, so no intra-package ignore is needed; the\n # three ignores below mirror the \"forge_cli layers\" contract exactly (the\n # pre-existing runtime.py:74 -> codex_orchestrator -> forge_cli.chain_core lazy\n # cross-link closes an indirect cycle into every submodule). TODO: remove with their