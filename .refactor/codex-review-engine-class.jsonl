\",\n+    \"_verbs_decision | _verbs_finalize | _verbs_gate | _verbs_gate_evals | _verbs_lifecycle | _verbs_review_collect | _verbs_review_request | _verbs_status | _verbs_tombstone\",\n     \"_finalize | _merge_candidate_generation\",\n     \"_approval | _candidate_ops | _fresh_eval_evidence | _gate_checks | _merge_bootstrap_child | _merge_candidate_observation\",\n     \"_archive | _classification | _cli_options | _command_lock | _fresh_eval | _journal | _merge_bootstrap_result | _merge_candidate | _merge_claim | _merge_conflict | _merge_epoch | _merge_rebase_integrated | _merge_scope_binding | _merge_scope_derive | _merge_worktree | _parser | _review_transport\",\n     \"_core\",\n     \"_state\",\n ]\n ignore_imports = [\n     \"forge_cli.runtime -> codex_orchestrator.batch\",\n     \"forge_cli.runtime -> codex_orchestrator.builders\",\n     \"forge_cli.runtime -> codex_orchestrator.journal\",\n ]\n \n [[tool.importlinter.contracts]]\n # forge_cli.app split (bead forge-plugin-hcuo): wave order of .refactor/plan-app.md; the same\n # lazy runtime -> codex_orchestrator cycle as the engine contract is ignored.\n name = \"forge_cli.app layers\"\n type = \"layers\"\n containers = [\"forge_cli.app\"]\n layers = [\n     \"_dispatch\",\n     \"_merge_engine\",\n     \"_admission | _candidate_observation | _mutation_journal\",\n ]\n ignore_imports = [\n     \"forge_cli.runtime -> codex_orchestrator.batch\",\n     \"forge_cli.runtime -> codex_orchestrator.builders\",\n     \"forge_cli.runtime -> codex_orchestrator.journal\",\n ]\n \n # codex_orchestrator must not depend on forge_cli at module import time. The four\n # function-level imports below are pre-existing lazy cross-links (2026-09-13); they\n # are ignored here so the contract tracks today's shape. TODO: remove each ignore\n # once the cross-link is gone (runtime.py:74 is the mirror-image lazy import from\n # forge_cli into codex_orchestrator; it is not covered by this contract).\n [[tool.importlinter.contracts]]\n name = \"codex_orchestrator does not import forge_cli\"\n type = \"forbidden\"\n source_modules = [\"codex_orchestrator\"]\n forbidden_modules = [\"forge_cli\"]\n ignore_imports = [\n     \"codex_orchestrator.builders -> forge_cli.candidate\",\n     \"codex_orchestrator.builders -> forge_cli.fresh_evals\",\n     \"codex_orchestrator.builders -> forge_cli.policy\",\n     \"codex_orchestrator.journal -> forge_cli.chain_core\",\n ]\ndiff --git a/tests/test_fr223_v2_byte_pins.py b/tests/test_fr223_v2_byte_pins.py\nindex 79152a9..7eb5816 100644\n--- a/tests/test_fr223_v2_byte_pins.py\n+++ b/tests/test_fr223_v2_byte_pins.py\n@@ -1,58 +1,58 @@\n \"\"\"Byte pins for the seven additive DM-016 v2 artifacts.\"\"\"\n \n from __future__ import annotations\n \n import hashlib\n import json\n import unittest\n from pathlib import Path\n \n \n ROOT = Path(__file__).resolve().parents[1]\n ARTIFACT_SHA256 = {\n     \".forge/evals/tasks/fr223-hook-argv-matcher-v2.md\": (\n         \"32b9d5d3559b310505d6c429bff7d867807df9fd2f2523acb25039d3038e318b\"\n     ),\n     \".forge/evals/tasks/fr223-hook-argv-matcher-v2.result\": (\n         \"09a6c264d3c4abdcb411b1659573ef239dad5df6f71760e7f44d8b36d73bf387\"\n     ),\n     \".forge/evals/tasks/fr223-reason-code-enum-v2.md\": (\n         \"286b220b59dfd8106503bf28e609ac3b77552e004d86b72761a40ea26d7aff31\"\n     ),\n     \".forge/evals/tasks/fr223-reason-code-enum-v2.result\": (\n         \"09a6c264d3c4abdcb411b1659573ef239dad5df6f71760e7f44d8b36d73bf387\"\n     ),\n     \".forge/evals/tasks/fr230-phase3-4-v2.manifest.json\": (\n-        \"ecac7920808577d30b91dd155e8b89e14105977c3ce0a039b0e941f2b3f5d3a0\"\n+        \"97e6c11e9355d2e58cd4b416aa42e8582d4c9c61c7ad59998e13da264420c87f\"\n     ),\n     \"system/fr223/hook-argv-cases-v2.json\": (\n         \"310bfda5efdbfe3c99a1d189c8ff336782f90a79af741c4098ada4ae579bde27\"\n     ),\n     \"system/fr223/reason-codes-v2.json\": (\n         \"6e33be25226111896dc6d6cf621935b414a8a5e1a509adb4ea4daa347c239a28\"\n     ),\n }\n \n \n class V2ArtifactBytePinTests(unittest.TestCase):\n     def test_all_seven_artifacts_match_the_generation_contract(self) -> None:\n         self.assertEqual(len(ARTIFACT_SHA256), 7)\n         for relative_path, expected in ARTIFACT_SHA256.items():\n             with self.subTest(path=relative_path):\n                 artifact = ROOT / relative_path\n                 self.assertTrue(artifact.is_file())\n                 self.assertFalse(artifact.is_symlink())\n                 raw = artifact.read_bytes()\n                 if relative_path.endswith(\"fr230-phase3-4-v2.manifest.json\"):\n                     payload = json.loads(raw.decode(\"utf-8\"))\n                     self.assertIn(payload.get(\"generation\"), {1, 2})\n                     if payload[\"generation\"] == 2:\n                         self.assertEqual(\n                             payload.get(\"previous_manifest_sha256\"), expected\n                         )\n                         continue\n                 self.assertEqual(hashlib.sha256(raw).hexdigest(), expected)\n \n \n if __name__ == \"__main__\":\n     unittest.main()\n","exit_code":0,"status":"completed"}}
