{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/usr/bin/zsh -lc \"python3 -c '\nimport ast, subprocess, pathlib, textwrap, difflib\nbase = subprocess.check_output([\\\"git\\\",\\\"show\\\",\\\"7e40590:scripts/forge/forge_cli/engine/_engine.py\\\"], text=True)\ncur_path = pathlib.Path(\\\"scripts/forge/forge_cli/engine/_engine.py\\\")\ncur = cur_path.read_text()\ndef class_methods(src):\n    tree=ast.parse(src)\n    cls=next(n for n in tree.body if isinstance(n,ast.ClassDef) and n.name==\\\"Engine\\\")\n    return {n.name:n for n in cls.body if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef))}, cls\ndef source_def(src,node):\n    lines=src.splitlines(keepends=True)\n    return textwrap.dedent(\\\"\\\".join(lines[node.lineno-1:node.end_lineno]))\nbase_methods,bcls=class_methods(base)\ncur_methods,ccls=class_methods(cur)\nmods={}\nfor p in sorted(pathlib.Path(\\\"scripts/forge/forge_cli/engine\\\").glob(\\\"_verbs_*.py\\\")):\n    src=p.read_text(); tree=ast.parse(src)\n    for n in tree.body:\n        if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)):\n            if n.name in mods: print(\\\"DUP-MODULE-FUNC\\\",n.name,mods[n.name][0],p)\n            mods[n.name]=(str(p),src,n)\nmoved=sorted(set(base_methods)-set(cur_methods))\nprint(\\\"base methods\\\",len(base_methods),sorted(base_methods))\nprint(\\\"current real methods\\\",len(cur_methods),sorted(cur_methods))\nprint(\\\"moved count\\\",len(moved),moved)\nprint(\\\"new real class methods\\\",sorted(set(cur_methods)-set(base_methods)))\nprint(\\\"missing moved funcs\\\",sorted(set(moved)-set(mods)))\nprint(\\\"extra module funcs\\\",sorted(set(mods)-set(moved)))\nfor name in moved:\n    if name not in mods: continue\n    p,nsrc,nn=mods[name]; bn=base_methods[name]\n    btxt=source_def(base,bn); ntxt=source_def(nsrc,nn)\n    if btxt \"'!= ntxt:\n        print(\"TEXT-MISMATCH\",name,p)\n        print(\"\".join(difflib.unified_diff(btxt.splitlines(True),ntxt.splitlines(