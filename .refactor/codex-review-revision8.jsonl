   },\n   148\t        \"pytest\": {\n   149\t            f\"{SRC}::{SRC_CLASS}::{m}\": f\"{cluster['dest']}::{cluster['target_class']}::{m}\"\n   150\t            for m in cluster[\"methods\"]\n   151\t        },\n   152\t    }\n   153\t    if os.path.exists(p[\"idmap\"]):\n   154\t        existing = json.load(open(p[\"idmap\"], encoding=\"utf-8\"))\n   155\t        if existing != idmap:\n   156\t            fail(f\"{label}: pre-existing {p['idmap']} differs from the generated id map\")\n   157\t    with open(p[\"idmap\"], \"w\", encoding=\"utf-8\") as handle:\n   158\t        json.dump(idmap, handle, indent=2, sort_keys=True)\n   159\t        handle.write(\"\\n\")\n   160\t\n   161\t\n   162\tdef mover_argv(cluster, p):\n   163\t    argv = [\n   164\t        \"python3\", f\"{D}/move_methods.py\", \"--project\", \".\", \"--import-root\", ROOT,\n   165\t        \"--source\", SRC, \"--class\", SRC_CLASS, \"--methods\", \",\".join(cluster[\"methods\"]),\n   166\t        \"--dest\", cluster[\"dest\"], \"--shape\", cluster[\"shape\"],\n   167\t        \"--target-class\", cluster[\"target_class\"], \"--test-only\",\n   168\t        \"--test-snapshot\", p[\"ids\"], \"--format-imports\", \"--manifest\", p[\"manifest\"],\n   169\t    ]\n   170\t    if cluster[\"shape\"] == \"class\":\n   171\t        argv += [\"--id-map\", p[\"idmap\"]]\n   172\t    return argv\n   173\t\n   174\t\n   175\tdef move(cluster, p):\n   176\t    label = cluster[\"label\"]\n   177\t    mover = mover_argv(cluster, p)\n   178\t    rc, out = run(mover, p[\"log\"], \"dry run\")\n   179\t    if label != \"mixin\":\n   180\t        with open(p[\"dryrun\"], \"w\", encoding=\"utf-8\") as handle:\n   181\t            handle.write(out)\n   182\t    if rc or \"DRY RUN: verified\" not in out:\n   183\t        fail(f\"{label}: dry run refused (see {p['log']})\")\n   184\t    snapshot = [\"python3\", f\"{S}/snapshot_bodies.py\", \"snapshot\", PKG, \"--out\", p[\"snap\"]]\n   185\t    if run(snapshot, p[\"log\"], \"snapshot\")[0]:\n   186\t        fail(f\"{label}: snapshot failed (see {p['log']})\")\n   187\t    if run(mover + [\"--apply\"], p[\"log\"], \"apply\")[0]:\n   188\t        fail(f\"{label}: apply failed (see {p['log']}); inspect git diff before recovering\")\n   189\t\n   190\t\n   191\tdef gate(cluster, p):\n   192\t    label = cluster[\"label\"]\n   193\t    verify = [\n   194\t        \"bash\", f\"{S}/verify.sh\", \"--pkg\", PKG, \"--snapshot\", p[\"snap\"],\n   195\t        \"--manifest\", p[\"manifest\"], \"--strict-bodies\",\n   196\t        \"--test-snapshot\", p[\"ids\"], \"--test-mode\", cluster[\"test_mode\"],\n   197\t    ]\n   198\t    rc, out = run(verify, p[\"gate\"], f\"verify.sh (--test-mode {cluster['test_mode']})\")\n   199\t    if rc or \"GATE: PASS\" not in out:\n   200\t        fail(f\"{label}: gate FAILED (see {p['gate']} and .refactor-gate.log)\")\n   201\t    guard = [\"python3\", \"scripts/check_file_length.py\", \"tests\"]\n   202\t    rc, out = run(guard, p[\"gate\"], \"repository file-length guard\")\n   203\t    if rc:\n   204\t        fail(f\"{label}: scripts/check_file_length.py FAILED (see {p['gate']})\")\n   205\t    bare = dict(ENV)\n   206\t    bare.pop(\"PYTHONPATH\", None)\n   207\t    module = SRC_MODULE if label == \"mixin\" else cluster[\"module\"]\n   208\t    rc, out = run([\"python3\", \"-m\", \"unittest\", f\"tests.{module}\"], p[\"gate\"],\n   209\t                  \"import without PYTHONPATH\", env=bare)\n   210\t    if rc or \"\\nOK\" not in out:\n   211\t        fail(f\"{label}: tests.{module} does not pass without PYTHONPATH (see {p['gate']})\")\n   212\t    # Critique finding 3: the new module must also import STANDALONE (first in a Gate 1 shard)\n   213\t    # without PYTHONPATH, i.e. its generated header must not import codex_orchestrator before\n   214\t    # the constants module has inserted scripts/ into sys.path.\n   215\t    standalone = [\"python3\", \"-c\", f\"import tests.{cluster['module']}\"]\n   216\t    rc, out = run(standalone, p[\"gate\"], \"standalone import without PYTHONPATH\", env=bare)\n   217\t    if rc:\n   218\t        fail(f\"{label}: tests.{cluster['module']} is not importable standalone without PYTHONPATH\")\n   219\t    evidence = [p[\"manifest\"], p[\"snap\"], p[\"ids\"], p[\"log\"], p[\"gate\"]]\n   220\t    if cluster[\"shape\"] == \"class\":\n   221\t        evidence += [p[\"idmap\"], p[\"dryrun\"]]\n   222\t    return evidence\n   223\t\n   224\t\n   225\tdef record(cluster, p, sha, dest_lines, src_lines):\n   226\t    records = []\n   227\t    if os.path.exists(RECORDS):\n   228\t        records = json.load(open(RECORDS, encoding=\"utf-8\"))\n   229\t    records.append({\n   230\t        \"label\": cluster[\"label\"], \"shape\": cluster[\"shape\"], \"commit\": sha,\n   231\t        \"snapshot\": p[\"snap\"], \"manifest\": p[\"manifest\"], \"test_snapshot\": p[\"ids\"],\n   232\t        \"id_map\": p[\"idmap\"] if cluster[\"shape\"] == \"class\" else None,\n   233\t        \"dest\": cluster[\"dest\"], \"dest_code_lines\": dest_lines, \"source_code_lines\": src_lines,\n   234\t        \"methods\": len(cluster[\"methods\"]),\n   235\t    })\n   236\t    with open(RECORDS, \"w\", encoding=\"utf-8\") as handle:\n   237\t        json.dump(records, handle, indent=2)\n   238\t        handle.write(\"\\n\")\n   239\t\n   240\t\n   241\tdef commit(cluster, p, evidence, dest_lines, src_lines):\n   242\t    label = cluster[\"label\"]\n   243\t    run([\"git\", \"add\", SRC, cluster[\"dest\"], *evidence])\n   244\t    if cluster[\"shape\"] == \"mixin\":\n   245\t        subject = f\"refactor(tests): move the {len(cluster['methods'])} revision8 helpers into \"\n   246\t        subject += \"tests/_revision8_support.py (mixin shape, tier 1)\"\n   247\t        what = (\n   248\t            \"setUp and every non-test helper of Revision8CoordinationTests moved verbatim by\\n\"\n   249\t            \"move_methods.py --shape mixin --import-root \\\"$PWD\\\" --format-imports; the class\\n\"\n   250\t            \"header becomes (Revision8Support, unittest.TestCase). Test IDs identical.\\n\"\n   251\t        )\n   252\t    else:\n   253\t        subject = (\n   254\t            f\"refactor(tests): move the {label} family ({len(cluster['methods'])} tests) to \"\n   255\t            f\"{cluster['dest']} (class shape, tier 1)\"\n   256\t        )\n   257\t        what = (\n   258\t            f\"Family {label} of the revision8 split moved verbatim by move_methods.py --shape\\n\"\n   259\t            f\"class --import-root \\\"$PWD\\\" --format-imports into {cluster['target_class']};\\n\"\n   260\t            f\"test IDs mapped 1:1 in both collectors ({p['idmap']}).\\n\"\n   261\t        )\n   262\t    message = (\n   263\t        f\"{subject}\\n\\n{what}\"\n   264\t        \"Manifest oracle --strict-bodies, ruff, file-length, types, lint-imports, the ID compare\\n\"\n   265\t        \"and the focused revision8 set PASS (evidence under .refactor/). \"\n   266\t        f\"{cluster['dest']}: {dest_lines} code lines; {SRC}: {src_lines}. \"\n   267\t        \"No production file changed.\\n\\n\" + TRAILER\n   268\t    )\n   269\t    proc = subprocess.run([\"git\", \"commit\", \"-q\", \"-F\", \"-\"], env=ENV, input=message,\n   270\t                          capture_output=True, text=True)\n   271\t    if proc.returncode:\n   272\t        fail(f\"{label}: commit failed:\\n{proc.stdout}{proc.stderr}\")\n   273\t    sha = head_sha()\n   274\t    # The records file stays untracked until the finalize commit (brief section 7 item 1).\n   275\t    record(cluster, p, sha, dest_lines, src_lines)\n   276\t    print(f\"{label}: committed {sha[:7]}\")\n   277\t\n   278\t\n   279\tdef run_cluster(label):\n   280\t    cluster = load_cluster(label)\n   281\t    p = paths_for(label)\n   282\t    count = len(cluster[\"methods\"])\n   283\t    print(f\"--- {label} ({cluster['shape']}, {count} methods) -> {cluster['dest']}\")\n   284\t    preflight(cluster, p)\n   285\t    collect_ids(cluster, p)\n   286\t    move(cluster, p)\n   287\t    evidence = gate(cluster, p)\n   288\t    dest_lines, src_lines = code_lines(cluster[\"dest\"]), code_lines(SRC)\n   289\t    print(f\"{label}: gate PASS, dest {dest_lines} code lines, source {src_lines}\")\n   290\t    commit(cluster, p, evidence, dest_lines, src_lines)\n   291\t\n   292\t\n   293\tdef main():\n   294\t    labels = sys.argv[1:]\n   295\t    if not labels:\n   296\t        fail(\"usage: revision8-run-cluster.py mixin | <family> [<family> ...]\")\n   297\t    for label in labels:\n   298\t        run_cluster(label)\n   299\t\n   300\t\n   301\tif __name__ == \"__main__\":\n   302\t    main()\n","exit_code":0,"status":"completed"}}
