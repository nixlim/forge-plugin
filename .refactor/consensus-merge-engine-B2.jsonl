rge-engine.md:97:  (`gate-merge-engine-wave-close-rerun-b0a2e72.txt`), and the Gate 1 cell at b0a2e72 in a worktree is 4/4 OK, 1908\n     1\t#!/usr/bin/env bash\n     2\t# Gate 1 cell at an arbitrary commit in a temporary worktree (review-round evidence).\n     3\t#   usage: merge-engine-gate1-at.sh <sha> <label>\n     4\tset -u\n     5\tsha=${1:?sha}; label=${2:?label}\n     6\texport TMPDIR=/dev/shm/forge-gate PYTHONPATH=scripts:scripts/forge; unset FORGE_SESSION_PID\n     7\troot=$(pwd); wt=$TMPDIR/wt-gate1-$label; rm -rf \"$wt\"; git worktree add -q --detach \"$wt\" \"$sha\"\n     8\tawk '/^## Gate 1 Test Command/{f=1;next} /^## /{f=0} f' \"$wt/forge-project.md\" | sed -n '/^```bash/,/^```/p' | sed '1d;$d' > \"$TMPDIR/gate1-cell-$label.sh\"\n     9\t( cd \"$wt\" && { echo \"commit=$(git rev-parse HEAD) start=$(date -u +%FT%TZ)\"; bash -c \"$(cat \"$TMPDIR/gate1-cell-$label.sh\")\"; echo \"gate1_rc=$?\"; echo \"end=$(date -u +%FT%TZ)\"; } ) > \"$root/.refactor/gate1-merge-engine-$label.txt\" 2>&1\n    10\tgit worktree remove --force \"$wt\"\n    11\techo done > \"$TMPDIR/gate1-$label.done\"\n     1\t#!/usr/bin/env bash\n     2\t# Review-round evidence (Codex B2/B3, 2026-09-22): digest/conformance tests at the wave-close\n     3\t# commit b0a2e72 in a temporary worktree, and the e05 bisect re-run with tracked output.\n     4\tset -u\n     5\troot=$(pwd); export TMPDIR=/dev/shm/forge-gate PYTHONPATH=scripts:scripts/forge; unset FORGE_SESSION_PID\n     6\tout=.refactor/gate-merge-engine-wave-close-rerun-b0a2e72.txt\n     7\twt=$TMPDIR/wt-b0a2e72; rm -rf \"$wt\"; git worktree add -q --detach \"$wt\" b0a2e72\n     8\t( cd \"$wt\" && { echo \"commit=$(git rev-parse HEAD) $(date -u +%FT%TZ)\"; python3 -m unittest tests.test_fr230_phase3_manifest tests.test_fr223_v2_byte_pins tests.test_repo_conformance 2>&1 | tail -4; echo \"digest_rc=${PIPESTATUS[0]}\"; } ) > \"$out\" 2>&1\n     9\tgit worktree remove --force \"$wt\"\n    10\tbis=.refactor/bisect-merge-engine-t2-e05.tx