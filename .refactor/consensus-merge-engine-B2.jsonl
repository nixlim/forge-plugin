gest/conformance tests at the wave-close\\n     3\\t# commit b0a2e72 in a temporary worktree, and the e05 bisect re-run with tracked output.\\n     4\\tset -u\\n     5\\troot=$(pwd); export TMPDIR=/dev/shm/forge-gate PYTHONPATH=scripts:scripts/forge; unset FORGE_SESSION_PID\\n     6\\tout=.refactor/gate-merge-engine-wave-close-rerun-b0a2e72.txt\\n     7\\twt=$TMPDIR/wt-b0a2e72; rm -rf \\\"$wt\\\"; git worktree add -q --detach \\\"$wt\\\" b0a2e72\\n     8\\t( cd \\\"$wt\\\" && { echo \\\"commit=$(git rev-parse HEAD) $(date -u +%FT%TZ)\\\"; python3 -m unittest tests.test_fr230_phase3_manifest tests.test_fr223_v2_byte_pins tests.test_repo_conformance 2>&1 | tail -4; echo \\\"digest_rc=${PIPESTATUS[0]}\\\"; } ) > \\\"$out\\\" 2>&1\\n     9\\tgit worktree remove --force \\\"$wt\\\"\\n    10\\tbis=.refactor/bisect-merge-engine-t2-e05.txt\\n    11\\ttests=\\\"tests.test_cli_merge_integration.MergeIntegrationEpochTests.test_inactive_older_only_landing_releases_tagged_terminal tests.test_cli_merge_integration.MergeIntegrationEpochTests.test_inactive_push_observed_requires_fresh_completed_progress\\\"\\n    12\\t{ echo \\\"e05 bisect re-run $(date -u +%FT%TZ): the two tests that failed the e05 parallel checkpoint, at each tier-2 commit\\\"\\n    13\\t  for sha in 6e60498 c81829d 034df09 913f275 05288f0 3f421b0; do\\n    14\\t    w=$TMPDIR/wt-bisect-$sha; rm -rf \\\"$w\\\"; git worktree add -q --detach \\\"$w\\\" \\\"$sha\\\"\\n    15\\t    r=$(cd \\\"$w\\\" && python3 -m unittest $tests 2>&1 | tail -1); echo \\\"$sha $(git log -1 --format=%s \\\"$sha\\\" | cut -c1-70): $r\\\"\\n    16\\t    git worktree remove --force \\\"$w\\\"\\n    17\\t  done; } > \\\"$bis\\\" 2>&1\\n    18\\techo done > \\\"$TMPDIR/review-evidence.done\\\"\\ncommit b0a2e727a6c23a9b895a0b78b58b5a97727199b4\\nAuthor:     nixlim <riabtchuk@gmail.com>\\nAuthorDate: Tue Sep 22 13:49:08 2026 +0200\\nCommit:     nixlim <riabtchuk@gmail.com>\\nCommitDate: Tue Sep 22 13:49:08 2026 +0200\\n\\n    chore(fr230): add