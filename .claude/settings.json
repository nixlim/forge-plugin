{
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/check_file_length.py --hook",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "codex-orchestrator@codex-orchestrator": true
  }
}
